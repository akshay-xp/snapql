{
  "name": "extension",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "vite build --mode chrome && vite build --mode firefox",
    "e2e": "vite build --mode chrome && vitest run --config vitest.e2e.config.ts",
    "screenshots": "vite build --mode chrome && vitest run --config vitest.store.config.ts",
    "listing-images": "node store/listing-images.ts",
    "release": "vite build --mode chrome && node scripts/release.ts"
  },
  "dependencies": {
    "solid-js": "^1.9.17"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/chrome": "^0.3.6",
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "playwright": "^1.64.1",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.5",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^5.0.5",
    "ws": "^8.22.0"
  }
}

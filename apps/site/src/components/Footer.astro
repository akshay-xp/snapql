---
import extension from "../../../extension/package.json"
import { REPO_URL, STORE_URL } from "../links"
---

<footer>
  <div class="wrap">
    <span class="label">SnapQL</span>
    <div class="links">
      <a href={STORE_URL}
        >Chrome Web Store</a
      >
      <a href={REPO_URL}>GitHub</a>
      <a href={`${REPO_URL}/issues`}>Report an issue</a>
    </div>
    <span class="mono meta">v{extension.version} · by akshay-xp</span>
  </div>
</footer>

<style>
  footer {
    background: var(--ink);
    color: var(--ground);
  }
  .wrap {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding-top: 40px;
    padding-bottom: 40px;
  }
  .label {
    letter-spacing: 0.16em;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 28px;
    font-size: 15px;
  }
  a,
  a:hover {
    color: var(--ground);
  }
  .meta {
    font-size: 13px;
    color: #b5b4b1;
  }
</style>

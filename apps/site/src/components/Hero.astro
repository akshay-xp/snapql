---
import extension from "../../../extension/package.json"
import { REPO_URL, STORE_URL } from "../links"
---

<section class="hero">
  <div class="wrap intro">
    <p class="label">Chrome DevTools extension · v{extension.version}</p>
    <h1>Network traffic in DevTools, made readable.</h1>
    <p class="subtitle">
      A DevTools tab that names each request by what it does and decodes what
      it carries.
    </p>
    <div class="actions">
      <a class="btn primary" href={STORE_URL}
        >Add to Chrome, it's free</a
      >
      <a class="btn ghost" href={REPO_URL}
        >View source on GitHub</a
      >
    </div>
    <p class="mono meta">
      No permissions needed · Your traffic stays in your browser · Free and open
      source
    </p>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
  }
  .intro {
    display: flex;
    flex-direction: column;
    gap: 28px;
    padding-top: 88px;
    padding-bottom: 56px;
  }
  p,
  h1 {
    margin: 0;
  }
  .label {
    color: var(--muted);
  }
  h1 {
    max-width: 760px;
    font-size: 72px;
    line-height: 1.04;
    font-weight: 600;
    letter-spacing: -0.03em;
  }
  .subtitle {
    max-width: 640px;
    font-size: 21px;
    line-height: 1.5;
    color: var(--muted);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    padding-top: 8px;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    padding: 0 22px;
    box-sizing: border-box;
    font-weight: 600;
    font-size: 16px;
    text-decoration: none;
    border: 1px solid var(--ink);
  }
  .primary,
  .primary:hover {
    background: var(--ink);
    color: var(--ground);
  }
  .primary:hover {
    background: #000;
  }
  .ghost:hover {
    background: rgba(38, 38, 38, 0.06);
  }
  .meta {
    font-size: 14px;
    color: var(--muted);
  }
  @media (max-width: 900px) {
    h1 {
      font-size: 44px;
    }
  }
</style>

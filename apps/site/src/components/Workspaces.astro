---
import { Image } from "astro:assets"
import shot from "../../../extension/store/captures/6-workspaces.png"

const rows = [
  {
    title: "Filter what matters",
    text: "Show only the protocols (graphql, grpc-web, websocket, llm…) and statuses (2xx, 4xx, failed) you're working on.",
  },
  {
    title: "Hide the noise",
    text: "Preflights, cached responses, service worker copies and static assets stay out of the list, out of the box.",
  },
  {
    title: "Switch in one click",
    text: "Jump between projects from the first button in the filter row. Nothing to save, nothing to set up again.",
  },
]
---

<section id="workspaces">
  <div class="wrap">
    <div class="copy">
      <p class="label">Workspaces</p>
      <h2>A saved view for every project you debug.</h2>
      <p class="intro">
        Pick the protocols and status codes you care about, hide the rest, and
        give it a name. Every change saves as you make it, and your workspaces
        are there each time you open DevTools.
      </p>
      <ul class="rows">
        {
          rows.map((row) => (
            <li>
              <span class="row-title">{row.title}</span>
              <span class="row-text">{row.text}</span>
            </li>
          ))
        }
      </ul>
    </div>
    <div class="shot">
      <Image
        src={shot}
        alt="The workspace menu open in SnapQL, listing Everything, Payments gRPC, Chat sockets and Flights GraphQL, with Flights GraphQL active and only graphql requests shown."
        width={1600}
        widths={[800, 1200, 1600]}
        sizes="(max-width: 900px) calc(100vw - 40px), 1120px"
        format="webp"
        loading="lazy"
      />
    </div>
  </div>
</section>

<style>
  section {
    background: var(--night);
    color: var(--night-text);
    /* clip, not hidden: a hidden box can still be scrolled sideways by
       scrollIntoView or focus, shifting the shot. */
    overflow: clip;
  }
  .wrap {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 72px;
    align-items: center;
    padding-top: 128px;
    padding-bottom: 128px;
  }
  .copy {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  p,
  h2 {
    margin: 0;
  }
  .label {
    color: var(--signal);
  }
  .intro {
    font-size: 19px;
    line-height: 1.6;
    color: var(--night-muted);
  }
  .rows {
    margin: 16px 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    border-top: 1px solid #3a3a3a;
  }
  .rows li {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 28px 0;
    border-bottom: 1px solid #3a3a3a;
  }
  .row-title {
    font-size: 18px;
    font-weight: 600;
  }
  .row-text {
    font-size: 16px;
    line-height: 1.6;
    color: var(--night-muted);
  }
  /* Runs off the page's right edge; the section clips it. */
  .shot {
    position: relative;
    height: 700px;
  }
  .shot img {
    position: absolute;
    left: 0;
    top: 0;
    width: 1120px;
    height: 700px;
    display: block;
    box-sizing: border-box;
    border: 1px solid #3a3a3a;
  }
  @media (max-width: 900px) {
    .wrap {
      grid-template-columns: minmax(0, 1fr);
    }
    .shot {
      height: auto;
    }
    .shot img {
      position: static;
      width: 100%;
      height: auto;
    }
  }
</style>

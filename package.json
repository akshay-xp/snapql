{
  "name": "snapql",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "biome check .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "build": "pnpm -r --if-present build",
    "e2e": "pnpm -r --if-present e2e",
    "screenshots": "pnpm --filter extension screenshots",
    "listing-images": "pnpm --filter extension listing-images",
    "release": "pnpm --filter extension release"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.12.1",
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "typescript": "^7.0.2"
  }
}
